DATABASE_URL=

CREATE_TABLES=false
MOCK_DELAY=0.02
CHAT_MODE=llm
LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/swiss-ai/apertus-v1.5-8b
# Cloudflare uses Chat Completions; OPENAI_* below are only used with LLM_PROVIDER=openai.
# LLM configuration belongs only to the backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:PORT/v1
OPENAI_MODEL=your-model
OPENAI_API_MODE=chat
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_SUMMARY=
# Neo4j settings may remain in the repository root .env.
LLM_HISTORY_MESSAGES=6
LLM_GUARD_MAX_TOKENS=64
LLM_PLAN_MAX_TOKENS=512
LLM_MAX_OUTPUT_TOKENS=1024
GRAPH_MAX_HOPS=3
GRAPH_MAX_SEEDS=4
GRAPH_NEIGHBORS_PER_NODE=8
GRAPH_MAX_NODES=60
GRAPH_MAX_EDGES=100
GRAPH_ANSWER_MAX_EDGES=16
# Defaults to apps/chatbot/be/.data/evidence.sqlite3 (resolved from config.py).
# EVIDENCE_INDEX_PATH=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
